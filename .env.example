# Optional — Gemini (legacy / unused by core portfolio)
# GEMINI_API_KEY=

# Recommended for contact form delivery on static hosts (GitHub Pages).
# Free key: https://web3forms.com — enter the email where you want messages.
# Safe to expose in the frontend (designed for client-side use).
# For GitHub Pages: set this in your build env or CI secrets before `vite build`.
VITE_WEB3FORMS_ACCESS_KEY=
